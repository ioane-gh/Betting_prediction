# ---------------------------------------------------------------------------
# Database (SQL Server 2019+ is the production target)
# ---------------------------------------------------------------------------
CHAMP_DB_DRIVER=ODBC Driver 18 for SQL Server
CHAMP_DB_HOST=localhost
CHAMP_DB_PORT=1433
CHAMP_DB_NAME=champ
CHAMP_DB_USER=sa
CHAMP_DB_PASSWORD=change-me
CHAMP_DB_TRUST_CERT=yes
# Windows integrated auth: set to 1 and leave USER/PASSWORD blank
CHAMP_DB_TRUSTED_CONNECTION=0
# Escape hatch: a full SQLAlchemy URL wins over every CHAMP_DB_* part above.
# Used by the test suite, e.g. sqlite:///./data/champ_test.db
# CHAMP_DB_URL=

# ---------------------------------------------------------------------------
# Data sources
# ---------------------------------------------------------------------------
# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_ORG_KEY=
CHAMP_DATA_DIR=./data
CHAMP_OUTPUT_DIR=./output
CHAMP_BACKFILL_SEASONS=10
# If season downloads hang or fail even after retries, a system/VPN proxy is
# a common cause on a managed Windows machine -- set this to route around
# whatever proxy the OS reports and connect directly instead.
CHAMP_IGNORE_SYSTEM_PROXY=0
# If football-data.co.uk is unreachable from this network at all (confirmed
# via a browser, not just this tool -- see README troubleshooting), switch to
# a GitHub-hosted mirror of the same underlying data. Current, same team
# names, same match stats and Over/Under 2.5 odds -- but no BTTS odds, so the
# BTTS backtest runs without a market comparison. co-uk remains the default:
# this is never switched automatically.
# CHAMP_HISTORICAL_SOURCE=github-mirror
# FBref/soccerdata enrichment is optional; the model runs without it.
CHAMP_ENABLE_FBREF=0
CHAMP_FBREF_CRAWL_DELAY=3.0

# ---------------------------------------------------------------------------
# Model hyperparameters
# ---------------------------------------------------------------------------
# Time decay: weight = exp(-ln(2) * days_ago / half_life)
CHAMP_DECAY_HALF_LIFE_DAYS=180
CHAMP_MAX_GOALS=10
# Teams below this weighted match count are shrunk toward the league mean.
CHAMP_MIN_WEIGHTED_MATCHES=20
CHAMP_SHRINKAGE_PRIOR=0.30
# Availability adjustment: alpha -= k * missing_attack_share, capped.
CHAMP_AVAILABILITY_K=0.5
CHAMP_AVAILABILITY_CAP=0.25
CHAMP_AVAILABILITY_OTHER_WEIGHT=0.3
# Head-to-head nudge. OFF until a backtest proves it helps (Phase 6/7).
CHAMP_ENABLE_H2H_ADJUSTMENT=0
CHAMP_H2H_WEIGHT=0.05
CHAMP_H2H_WINDOW=10
# Refit if the stored fit is older than this many days.
CHAMP_REFIT_AFTER_DAYS=7
CHAMP_LOG_LEVEL=INFO
